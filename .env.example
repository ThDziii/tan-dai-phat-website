# Public Sanity configuration for the Tân Đại Phát website.
# Copy this file to `.env` and fill in the values from https://www.sanity.io/manage
#
# These variables are exposed to the browser by Vite.
# Do not put a Sanity write token, private API key, or any other secret here.
# The public site only reads published documents and does not authenticate.

VITE_SANITY_PROJECT_ID=bp4nez5i
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2025-02-19
